
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dot Art Studio Pro</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#07101f;color:#edf5ff;font-family:Arial,sans-serif}
header{text-align:center;padding:20px 12px;background:linear-gradient(130deg,#142b50,#07546a)}
h1{margin:0;font-size:25px}
header p{color:#d0e8f8;font-size:13px}
main{max-width:1000px;margin:auto;padding:12px}
.panel{background:#101d31;border:1px solid #263c59;border-radius:15px;padding:14px;margin-bottom:12px}
h3{margin:0 0 12px;font-size:15px}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
button,.file{border:1px solid #39516f;border-radius:9px;background:#1b304a;color:white;padding:11px;cursor:pointer;font-size:13px}
button.primary,.file{background:#087f9d;border-color:#35d8f5}
button:disabled{opacity:.45}
.row button,.row .file{flex:1;text-align:center}
input,select{width:100%;margin-top:7px}
input[type=range]{accent-color:#4de3ff}
input[type=number],select{padding:10px;border-radius:8px;background:#1b304a;color:white;border:1px solid #39516f}
label{font-size:12px;color:#b7c8df}
.control{margin-top:15px}
#preview{width:100%;height:auto;display:block;background:#fff;border-radius:8px}
.preview-wrap{overflow:auto;max-height:70vh;background:#fff;border-radius:8px}
.note{font-size:12px;color:#a8bad2;line-height:1.6}
#status{color:#75eaff;font-size:12px;line-height:1.6;margin-top:10px}
#file{display:none}
.badge{color:#7deaff}
</style>
</head>
<body>
<header>
<h1>🎨 Dot Art Studio Pro</h1>
<p>Photo to Detailed Color Dot Portrait</p>
</header>

<main>
<section class="panel">
<h3>1. Gallery Photo</h3>
<div class="row">
<label class="file" for="file">🖼️ Choose Photo</label>
<button id="convert" class="primary">✨ Create Detailed Dots</button>
<input id="file" type="file" accept="image/*">
</div>
<p class="note">Clear face photo चुनें। सिस्टम फोटो के हर हिस्से से automatic colors sample करेगा। आपको अलग-अलग रंग भरने की जरूरत नहीं है।</p>

<div class="control">
<label>Detail Level: <span id="detailVal">4</span> px spacing</label>
<input id="detail" type="range" min="2" max="12" step="1" value="4">
<p class="note">2–3 = बहुत बारीक details, 4–6 = balanced, 8–12 = बड़े dots। छोटे dots से फोटो अधिक स्पष्ट हो सकती है।</p>
</div>

<div class="control">
<label>Dot Size</label>
<input id="dotSize" type="range" min="55" max="110" value="94">
<p class="note">100% के पास रखने से dots पास-पास रहेंगे।</p>
</div>

<div class="control">
<label>Detail Enhancement: <span id="sharpVal">35</span>%</label>
<input id="sharp" type="range" min="0" max="100" value="35">
<p class="note">Edges और छोटे details को थोड़ा उभारता है।</p>
</div>

<div class="control">
<label>Color Mode</label>
<select id="mode">
<option value="original">Original Photo Colors — Recommended</option>
<option value="mono">Black & White</option>
<option value="warm">Warm Colors</option>
<option value="neon">Neon Colors</option>
</select>
</div>
<div class="control">
<label>Output Quality</label>
<select id="quality">
<option value="1200">High — 1200 px</option>
<option value="1600" selected>Ultra — 1600 px</option>
<option value="2000">Maximum — 2000 px</option>
</select>
</div>
</section>

<section class="panel">
<h3>2. Your Dot Portrait</h3>
<div class="preview-wrap">
<canvas id="preview" width="800" height="600"></canvas>
</div>
<div id="status">अपनी Gallery photo चुनें और Create Detailed Dots दबाएँ।</div>
<div class="row" style="margin-top:12px">
<button id="download" class="primary" disabled>⬇ Save PNG</button>
<button id="share" disabled>📤 Share Image</button>
<button id="reset">↺ Reset</button>
</div>
<p class="note">यह प्रक्रिया browser में locally होती है। फोटो किसी server पर upload नहीं होती।</p>
</section>
</main>

<script>
const $=id=>document.getElementById(id);
const canvas=$("preview");
const ctx=canvas.getContext("2d",{alpha:false});
let source=null;
let outputReady=false;
let busy=false;
let renderId=0;

function status(s){$("status").textContent=s}

function clearPreview(){
  ctx.fillStyle="#e8edf4";
  ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle="#52657c";
  ctx.font="20px Arial";
  ctx.textAlign="center";
  ctx.fillText("Your Dot Art will appear here",canvas.width/2,canvas.height/2);
  outputReady=false;
  $("download").disabled=true;
  $("share").disabled=true;
}
clearPreview();

$("detail").oninput=()=>{
  $("detailVal").textContent=$("detail").value;
};
$("sharp").oninput=()=>{
  $("sharpVal").textContent=$("sharp").value;
};

$("file").onchange=e=>{
  const file=e.target.files[0];
  if(!file)return;
  if(!file.type.startsWith("image/")){
    status("Please choose a valid image.");
    return;
  }

  const url=URL.createObjectURL(file);
  const img=new Image();
  img.onload=()=>{
    source=img;
    URL.revokeObjectURL(url);
    status("Photo loaded. अब Create Detailed Dots दबाएँ।");
    $("convert").disabled=false;
  };
  img.onerror=()=>{
    URL.revokeObjectURL(url);
    status("Image open नहीं हो पाई। दूसरी photo चुनें।");
  };
  img.src=url;
};

function sampleAverage(data,w,h,x,y,step,sharp){
  // Center-weighted color sampling retains facial features.
  let rr=0,gg=0,bb=0,total=0;
  const radius=Math.max(1,Math.floor(step*.28));
  const cx=Math.max(0,Math.min(w-1,Math.round(x)));
  const cy=Math.max(0,Math.min(h-1,Math.round(y)));

  for(let dy=-radius;dy<=radius;dy++){
    for(let dx=-radius;dx<=radius;dx++){
      const px=Math.max(0,Math.min(w-1,cx+dx));
      const py=Math.max(0,Math.min(h-1,cy+dy));
      const i=(py*w+px)*4;
      const weight=1/(1+dx*dx+dy*dy);
      rr+=data[i]*weight;
      gg+=data[i+1]*weight;
      bb+=data[i+2]*weight;
      total+=weight;
    }
  }

  let r=rr/total,g=gg/total,b=bb/total;

  // Local contrast enhancement helps preserve eyes, hair and outlines.
  if(sharp>0){
    const i=(cy*w+cx)*4;
    const amount=sharp*.48;
    r+=(data[i]-r)*amount;
    g+=(data[i+1]-g)*amount;
    b+=(data[i+2]-b)*amount;
  }
  return [r,g,b];
}

function colorFor(rgb,mode){
  let [r,g,b]=rgb;
  if(mode==="mono"){
    const gray=.299*r+.587*g+.114*b;
    r=g=b=gray;
  }else if(mode==="warm"){
    r=Math.min(255,r*1.06+8);
    g=Math.min(255,g*1.01+3);
    b=Math.max(0,b*.88);
  }else if(mode==="neon"){
    r=Math.min(255,r*1.18+8);
    g=Math.min(255,g*1.15+5);
    b=Math.min(255,b*1.2+8);
  }
  return `rgb(${Math.round(r)},${Math.round(g)},${Math.round(b)})`;
}

async function createDots(){
  if(!source){
    $("file").click();
    status("पहले Gallery से photo चुनें।");
    return;
  }
  if(busy)return;
  busy=true;
  const id=++renderId;
  $("convert").disabled=true;
  status("Preparing image and sampling colors...");

  // Limit output dimensions to keep phones responsive.
  const maxDim=Number($("quality").value);
  const scale=Math.min(maxDim/source.width,maxDim/source.height,1);
  const w=Math.max(1,Math.round(source.width*scale));
  const h=Math.max(1,Math.round(source.height*scale));

  const temp=document.createElement("canvas");
  temp.width=w;temp.height=h;
  const tc=temp.getContext("2d",{willReadFrequently:true});
  tc.drawImage(source,0,0,w,h);

  let data;
  try{
    data=tc.getImageData(0,0,w,h).data;
  }catch(err){
    status("Photo process नहीं हो पाई। छोटी photo try करें।");
    busy=false;
    $("convert").disabled=false;
    return;
  }

  canvas.width=w;
  canvas.height=h;
  ctx.fillStyle="#ffffff";
  ctx.fillRect(0,0,w,h);

  const step=Number($("detail").value);
  const dotScale=Number($("dotSize").value)/100;
  const radius=Math.max(.55,step*.5*dotScale);
  const sharp=Number($("sharp").value)/100;
  const mode=$("mode").value;

  const cols=Math.ceil(w/step);
  const rows=Math.ceil(h/step);
  const total=cols*rows;
  let count=0;

  // Yield periodically so the browser UI can remain responsive.
  for(let y=0;y<h;y+=step){
    if(id!==renderId) return;
    for(let x=0;x<w;x+=step){
      const rgb=sampleAverage(
        data,w,h,
        Math.min(w-1,x+step/2),
        Math.min(h-1,y+step/2),
        step,sharp
      );
      ctx.fillStyle=colorFor(rgb,mode);
      ctx.beginPath();
      ctx.arc(
        x+step/2,
        y+step/2,
        radius,0,Math.PI*2
      );
      ctx.fill();
      count++;
    }
    if(y%(step*40)===0){
      status("Creating detailed dots: "+Math.round(count/total*100)+"%");
      await new Promise(resolve=>setTimeout(resolve,0));
    }
  }

  if(id!==renderId)return;
  busy=false;
  outputReady=true;
  $("convert").disabled=false;
  $("download").disabled=false;
  $("share").disabled=false;
  status("Done! "+count.toLocaleString()+" colored dots created. PNG save या share करें।");
}

$("convert").onclick=createDots;

$("download").onclick=()=>{
  if(!outputReady)return;
  canvas.toBlob(blob=>{
    if(!blob){status("PNG export failed.");return;}
    const url=URL.createObjectURL(blob);
    const a=document.createElement("a");
    a.href=url;
    a.download="detailed-dot-portrait.png";
    a.click();
    setTimeout(()=>URL.revokeObjectURL(url),2000);
    status("PNG save शुरू हो गया।");
  },"image/png");
};

$("share").onclick=async()=>{
  if(!outputReady)return;
  canvas.toBlob(async blob=>{
    if(!blob)return;
    const file=new File([blob],"dot-portrait.png",{type:"image/png"});
    try{
      if(navigator.canShare&&navigator.canShare({files:[file]})){
        await navigator.share({
          title:"My Dot Portrait",
          text:"Created with Dot Art Studio Pro",
          files:[file]
        });
      }else{
        status("Direct share उपलब्ध नहीं है। Save PNG करके Gallery से भेजें।");
      }
    }catch(e){
      if(e.name!=="AbortError")status("Share नहीं हो पाया। PNG save करें।");
    }
  },"image/png");
};

$("reset").onclick=()=>{
  renderId++;
  busy=false;
  source=null;
  $("file").value="";
  $("convert").disabled=false;
  clearPreview();
  status("Reset complete. नई photo चुनें।");
};
</script>
</body>
  </html>
  
